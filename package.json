{
  "name": "energy-dashboard",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "cloudflare:deploy": "wrangler deploy --config cloudflare/refresh-trigger/wrangler.jsonc",
    "cloudflare:dev": "wrangler dev --config cloudflare/refresh-trigger/wrangler.jsonc --test-scheduled",
    "preview": "vite preview",
    "data:update": "node scripts/update-energy-data.mjs",
    "test": "node --test tests/cloudflare-trigger.test.mjs tests/energy-data.test.mjs tests/energy-enrichment.test.mjs tests/publication-workflow.test.mjs tests/pwa.test.mjs tests/sites-worker.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.10.1",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "wrangler": "^4.120.0"
  }
}
